{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"files": {
		"ignoreUnknown": true,
		"maxSize": 5242880, // 5 MB
		"includes": [
			"**/*.{js,ts,json,jsonc}",
			"!**/__generated__",
			"!!**/dist",
			"!!.vscode"
		]
	},
	"formatter": {
		"enabled": true,
		"useEditorconfig": true,
		"lineWidth": 120,
		"bracketSameLine": false,
		"bracketSpacing": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"useSortedKeys": "off",
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							[
								":BUN:",
								":NODE:"
							],
							[
								":PACKAGE:",
								"!src/**"
							],
							":BLANK_LINE:",
							":ALIAS:",
							":BLANK_LINE:",
							[
								"src",
								"src/**"
							],
							":BLANK_LINE:",
							[
								"..",
								"../**"
							],
							":BLANK_LINE:",
							[
								".",
								"./**"
							]
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"enabled": true,
			"quoteStyle": "single",
			"arrowParentheses": "asNeeded"
		}
	}
}
