{
  "name": "@nyanstream/snat",
  "version": "1.0.0",
  "private": "true",
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch run ./src/index.ts",
    "dist": "rm -rf dist && NODE_ENV=production bun build --entrypoints ./src/index.ts ./src/cli.ts --target=bun --sourcemap=linked --outdir dist",
    "start": "bun run ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "bun run ./scripts/is-ci.cjs && biome ci src || biome check src",
    "lint:fix": "biome check src --write",
    "prisma:generate-client": "bunx --bun prisma generate",
    "prisma:migrate-dev": "bunx --bun prisma migrate dev",
    "prisma:migrate-deploy": "bunx --bun prisma migrate deploy",
    "init-dev-env": "cp .env.example .env"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.1",
    "@elysiajs/openapi": "1.4.14",
    "@prisma/adapter-pg": "7.5.0",
    "@prisma/client": "7.5.0",
    "elysia": "1.4.28",
    "es-toolkit": "1.45.1",
    "fast-json-stringify": "6.3.0",
    "jsonwebtoken": "9.0.3",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "prisma-query-formatter": "1.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@types/bun": "1.3.11",
    "@types/jsonwebtoken": "9.0.10",
    "ci-info": "4.4.0",
    "lint-staged": "16.4.0",
    "prisma": "7.5.0",
    "typescript": "5.9.3"
  }
}
